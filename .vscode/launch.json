{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Orbit: website",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/dev.py",
      "args": [
        "server"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Orbit: agent (dry run)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.dev/orbit-agent",
      "args": [
        "--dev",
        "--state-dir",
        "${workspaceFolder}/.dev/agent"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Orbit: build debug agent"
    },
    {
      "name": "Orbit: agent (enforce)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.dev/orbit-agent",
      "args": [
        "--dev",
        "--enforce",
        "--state-dir",
        "${workspaceFolder}/.dev/agent"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Orbit: build debug agent"
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder}",
      "name": "Debug orbit-agent",
      "target": "orbit-agent",
      "configuration": "debug",
      "preLaunchTask": "swift: Build Debug orbit-agent"
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder}",
      "name": "Release orbit-agent",
      "target": "orbit-agent",
      "configuration": "release",
      "preLaunchTask": "swift: Build Release orbit-agent"
    }
  ],
  "compounds": [
    {"name": "Orbit: website + agent (dry run)", "configurations": ["Orbit: website", "Orbit: agent (dry run)"], "stopAll": true},
    {"name": "Orbit: website + agent (enforce)", "configurations": ["Orbit: website", "Orbit: agent (enforce)"], "stopAll": true}
  ]
}
