{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Orbit: VPS blocker + tracker (dry run)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/dev.py",
      "args": [
        "all"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Orbit: agent (dry run)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.dev/vps/orbit-agent",
      "args": [
        "--dev",
        "--state-dir",
        "${workspaceFolder}/.dev/vps/agent"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Orbit: build debug agent"
    },
    {
      "name": "Orbit: agent (enforce)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.dev/vps/orbit-agent",
      "args": [
        "--dev",
        "--enforce",
        "--state-dir",
        "${workspaceFolder}/.dev/vps/agent"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Orbit: build debug agent"
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [
        "--dev",
        "--state-dir",
        "${workspaceFolder}/.dev/vps/agent"
      ],
      "cwd": "${workspaceFolder}",
      "name": "Debug orbit-agent",
      "target": "orbit-agent",
      "configuration": "debug",
      "preLaunchTask": "Orbit: build debug agent"
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [
        "--dev",
        "--state-dir",
        "${workspaceFolder}/.dev/vps/agent"
      ],
      "cwd": "${workspaceFolder}",
      "name": "Release orbit-agent",
      "target": "orbit-agent",
      "configuration": "release",
      "preLaunchTask": "Orbit: build debug agent"
    }
  ],
  "compounds": []
}
